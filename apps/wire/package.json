{
  "name": "@asimposium/wire",
  "version": "0.0.0",
  "private": true,
  "description": "Stoa / Propylon / Symposiarch / Herald — the ASImposium Cloudflare Worker. The only process that writes to D1.",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test scripts",
    "test": "bun scripts/suites.ts default",
    "test:unit": "bun scripts/suites.ts unit",
    "test:contract": "bun scripts/suites.ts contract",
    "test:integration": "bun scripts/suites.ts integration",
    "test:e2e": "bun scripts/suites.ts e2e",
    "test:security": "bun scripts/suites.ts security",
    "test:performance": "bun scripts/suites.ts performance",
    "suites": "bun scripts/suites.ts list",
    "dev": "wrangler dev --config ../../infra/wrangler.toml",
    "deploy": "wrangler deploy --config ../../infra/wrangler.toml"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260814.1",
    "@types/bun": "1.3.14",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "wrangler": "4.123.0"
  }
}
