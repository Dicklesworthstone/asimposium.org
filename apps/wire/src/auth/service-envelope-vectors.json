{
  "$comment": [
    "Golden canonicalization vectors for the signed service envelope.",
    "Both planes pin these: apps/wire verifies, apps/web signs, and each has its own",
    "implementation of the canonical form. If the two ever disagree by a single byte,",
    "every sponsor write breaks in production and the failure looks like a bad key --",
    "so the agreement is asserted here instead of assumed.",
    "canonical_sha256 is SHA-256 of canonicalBytes(claims), lowercase hex.",
    "These values are hand-checked and MUST NOT be regenerated to make a red test green:",
    "a changed digest means the signing domain changed, which is a version bump.",
    "This corpus belongs in packages/contracts once W1.1 exists (asimposiumorg-phg);",
    "it lives here because the Worker is the authoritative verifier and contracts is",
    "out of scope for the S-6 spike."
  ],
  "vectors": {
    "minimal": {
      "note": "A typical sponsor directive write.",
      "claims": {
        "v": "asimp-env-1",
        "kid": "agora-2026-08-a",
        "alg": "Ed25519",
        "iss": "agora",
        "aud": "stoa",
        "iat": 1786000000,
        "exp": 1786000060,
        "nonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "method": "POST",
        "route": "/v1/p/:id/directives",
        "action": "directive.create",
        "principal_type": "sponsor",
        "principal_id": "usr_01JXYZ0000000000000000",
        "payload_sha256": "c752ec509015332ddff46c49113b318657a915f5dc43fb92e418c323d61ea48b"
      },
      "canonical_sha256": "f8ae22b637fa98fa6c963aace0c0817a8e65c4654be186eb71fc6b672e7aa37a"
    },
    "unicode-nonbmp": {
      "note": "Non-BMP characters: lengths must be UTF-8 bytes, not UTF-16 code units. An implementation using String.length here produces a different digest and every write fails.",
      "claims": {
        "v": "asimp-env-1",
        "kid": "agora-2026-08-a",
        "alg": "Ed25519",
        "iss": "agora",
        "aud": "stoa",
        "iat": 1786000000,
        "exp": 1786000060,
        "nonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "method": "POST",
        "route": "/v1/p/:id/directives",
        "action": "directive.créate.𝔘",
        "principal_type": "sponsor",
        "principal_id": "usr_𝔘nicode_01",
        "payload_sha256": "c752ec509015332ddff46c49113b318657a915f5dc43fb92e418c323d61ea48b"
      },
      "canonical_sha256": "896cca4ec36a98ef9a401e0d5bf751d0c1a9aec7bfb43b4aa165d375de56f865"
    },
    "delimiter-collision-a": {
      "note": "Paired with -b. These two move a ':' between 'action' and 'principal_id'. They are NOT adjacent in the field list -- 'principal_type' sits between them -- so a value-joined encoding does not actually collide on this pair, and this pair is not a counterexample to one. What it pins is narrower and still worth pinning: a ':' inside a signed value is carried literally and changes the digest, rather than being read as framing. The real adjacent-field collision, where a delimiter-only scheme genuinely cannot tell two claim sets apart, is planted in apps/wire/test/unit/auth-canonical-vectors.test.ts.",
      "claims": {
        "v": "asimp-env-1",
        "kid": "agora-2026-08-a",
        "alg": "Ed25519",
        "iss": "agora",
        "aud": "stoa",
        "iat": 1786000000,
        "exp": 1786000060,
        "nonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "method": "POST",
        "route": "/v1/p/:id/directives",
        "action": "a:1",
        "principal_type": "sponsor",
        "principal_id": "b",
        "payload_sha256": "c752ec509015332ddff46c49113b318657a915f5dc43fb92e418c323d61ea48b"
      },
      "canonical_sha256": "3f29545613e1512c0904aa0e87ca6c463ba6544b468e65fc0f350d6808ca02ac"
    },
    "delimiter-collision-b": {
      "note": "Paired with -a. See that entry's note: this pair pins literal-':' handling, not a naive-concatenation collision.",
      "claims": {
        "v": "asimp-env-1",
        "kid": "agora-2026-08-a",
        "alg": "Ed25519",
        "iss": "agora",
        "aud": "stoa",
        "iat": 1786000000,
        "exp": 1786000060,
        "nonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "method": "POST",
        "route": "/v1/p/:id/directives",
        "action": "a",
        "principal_type": "sponsor",
        "principal_id": "1:b",
        "payload_sha256": "c752ec509015332ddff46c49113b318657a915f5dc43fb92e418c323d61ea48b"
      },
      "canonical_sha256": "b21b61a9d013b74f0624aedee218431450afca248c0c91c586a22bca8428726b"
    },
    "record-separator-in-value": {
      "note": "A raw 0x1E record separator inside a signed value. It is written as an escape here on purpose: as a literal byte it is invisible in every diff and editor, which is exactly how this vector gets silently mangled. The framing must not let it terminate a record early.",
