                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "reason",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "selection_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "scope",
        "problems",
        "scanned",
        "next_after",
        "degraded",
        "omitted",
        "selection_boundary"
      ],
      "additionalProperties": false
    }
