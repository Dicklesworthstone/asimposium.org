{
  "$id": "https://a.asimposium.org/schemas/moves.v1.json",
  "title": "ASImposium move catalog and live scientific needs",
  "description": "Typed next actions and contracts for the marching-orders engine (Fable §9.4, ADR-24).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1.0-draft"
    },
    "schema": {
      "type": "string",
      "const": "https://a.asimposium.org/schemas/moves.v1.json"
    },
    "scope": {
      "type": "string",
      "const": "catalog"
