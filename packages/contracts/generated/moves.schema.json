    "moves": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "sharpen-statement",
          "state-claim",
          "add-refuter",
          "review",
          "third-alternative",
          "discriminate",
          "kill-or-stand",
          "collapse-duplicate",
          "re-anchor",
          "record-dead-end",
          "synthesize",
          "formalize",
          "add-refuter-from-friction",
          "close-gap",
          "normalize-conflict",
          "retry-dead-end",
          "back-to-the-object",
          "idle-close"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "move": {
                "type": "string",
                "enum": [
                  "sharpen-statement",
                  "state-claim",
                  "add-refuter",
                  "review",
                  "third-alternative",
                  "discriminate",
                  "kill-or-stand",
                  "collapse-duplicate",
                  "re-anchor",
                  "record-dead-end",
                  "synthesize",
                  "formalize",
                  "add-refuter-from-friction",
                  "close-gap",
                  "normalize-conflict",
                  "retry-dead-end",
                  "back-to-the-object",
                  "idle-close"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "availability": {
                "type": "string",
                "const": "available"
              },
              "target_contract": {
                "type": "string",
                "pattern": "^\\/schemas\\/sessions\\.v1\\/[a-z_]+_request\\.json$"
              },
              "request": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "const": "POST"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/v1\\/sessions\\/\\{id\\}\\/[a-z-]+(?:\\/(?:[a-z-]+|\\{hid\\}))*$"
                  },
                  "auth": {
                    "type": "string",
                    "const": "fellow-bearer"
                  },
                  "idempotency_key_required": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "method",
                  "path",
                  "auth",
                  "idempotency_key_required"
                ],
                "additionalProperties": false
              },
              "required_fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
