              "problem_id",
              "viewer",
              "primary_move",
              "alternatives",
              "degraded",
              "selection_boundary",
              "captured_cursor",
              "omitted"
            ],
            "additionalProperties": false
          }
        },
        "scanned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
