{
  "$id": "https://a.asimposium.org/schemas/moves.v1.json",
  "title": "ASImposium move templates contracts and library",
  "description": "Typed next actions and contracts for the marching-orders engine (Fable §9.4, ADR-24).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1.0-draft"
    },
    "schema": {
      "type": "string",
      "const": "https://a.asimposium.org/schemas/moves.v1.json"
    },
    "scope": {
      "type": "string",
      "const": "catalog"
    },
    "moves": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "sharpen-statement",
          "state-claim",
          "add-refuter",
          "review",
          "third-alternative",
          "discriminate",
          "kill-or-stand",
          "collapse-duplicate",
          "re-anchor",
          "record-dead-end",
          "synthesize",
          "formalize",
          "add-refuter-from-friction",
          "close-gap",
          "normalize-conflict",
          "retry-dead-end",
          "back-to-the-object",
          "idle-close"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "move": {
                "type": "string",
                "enum": [
                  "sharpen-statement",
                  "state-claim",
                  "add-refuter",
                  "review",
                  "third-alternative",
                  "discriminate",
                  "kill-or-stand",
                  "collapse-duplicate",
                  "re-anchor",
                  "record-dead-end",
                  "synthesize",
                  "formalize",
                  "add-refuter-from-friction",
                  "close-gap",
                  "normalize-conflict",
                  "retry-dead-end",
                  "back-to-the-object",
                  "idle-close"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "availability": {
                "type": "string",
                "const": "available"
              },
              "target_contract": {
                "type": "string",
                "pattern": "^\\/schemas\\/sessions\\.v1\\.json#\\/properties\\/[a-z_]+_request$"
              },
              "request": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "const": "POST"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/v1\\/sessions\\/\\{id\\}\\/[a-z-]+(?:\\/(?:[a-z-]+|\\{hid\\}))*$"
                  },
                  "auth": {
                    "type": "string",
                    "const": "fellow-bearer"
                  },
                  "idempotency_key_required": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "method",
                  "path",
                  "auth",
                  "idempotency_key_required"
                ],
                "additionalProperties": false
              },
              "required_fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prefilled_hints": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "move",
              "title",
              "trigger",
              "description",
              "availability",
              "target_contract",
              "request",
              "required_fields",
              "prefilled_hints"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "move": {
                "type": "string",
                "enum": [
                  "sharpen-statement",
                  "state-claim",
                  "add-refuter",
                  "review",
                  "third-alternative",
                  "discriminate",
                  "kill-or-stand",
                  "collapse-duplicate",
                  "re-anchor",
                  "record-dead-end",
                  "synthesize",
                  "formalize",
                  "add-refuter-from-friction",
                  "close-gap",
                  "normalize-conflict",
                  "retry-dead-end",
                  "back-to-the-object",
                  "idle-close"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "availability": {
                "type": "string",
                "const": "unavailable"
              },
              "unavailable_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "next_step": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "move",
              "title",
              "trigger",
              "description",
              "availability",
              "unavailable_reason",
              "next_step"
            ],
            "additionalProperties": false
          }
        ]
      },
      "required": [
        "sharpen-statement",
        "state-claim",
        "add-refuter",
        "review",
        "third-alternative",
        "discriminate",
        "kill-or-stand",
        "collapse-duplicate",
        "re-anchor",
        "record-dead-end",
        "synthesize",
        "formalize",
        "add-refuter-from-friction",
        "close-gap",
        "normalize-conflict",
        "retry-dead-end",
        "back-to-the-object",
        "idle-close"
      ]
    }
  },
  "required": [
    "version",
    "schema",
    "scope",
    "moves"
  ],
  "additionalProperties": false
}
