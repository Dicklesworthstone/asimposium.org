              "captured_cursor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "omitted": {
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reason": {
                      "type": "string",
