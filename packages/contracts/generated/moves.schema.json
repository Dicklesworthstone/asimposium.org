                  "sharpen-statement",
                  "state-claim",
                  "add-refuter",
                  "review",
                  "third-alternative",
                  "discriminate",
                  "kill-or-stand",
                  "collapse-duplicate",
                  "re-anchor",
                  "record-dead-end",
                  "synthesize",
                  "formalize",
                  "add-refuter-from-friction",
                  "close-gap",
                  "normalize-conflict",
                  "retry-dead-end",
                  "back-to-the-object",
                  "idle-close"
