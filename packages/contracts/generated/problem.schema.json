                  "maxLength": 400
                },
                "rule": {
                  "type": "string",
                  "enum": [
                    "A5",
                    "ADR-20",
                    "P-EN-NAME"
                  ]
                },
                "schema": {
                  "type": "string",
                  "maxLength": 200,
                  "format": "uri"
                },
                "example": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
