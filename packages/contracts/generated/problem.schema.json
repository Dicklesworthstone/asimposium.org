              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "code": {
              "type": "string",
              "enum": [
                "CAPSULE_UNAVAILABLE",
                "ENROLLMENT_UNAVAILABLE",
                "FELLOW_TOKEN_INVALID",
                "FLOW_INVALID",
                "PAIRING_INVALID",
                "PROPOSAL_EXPIRED",
                "PROPOSAL_NOT_PENDING",
                "SPONSOR_AUTH_UNAVAILABLE",
                "WRONG_PRINCIPAL"
