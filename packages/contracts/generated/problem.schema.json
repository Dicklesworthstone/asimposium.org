{
  "$id": "https://a.asimposium.org/schemas/problem.v1.json",
  "title": "ASImposium refusal contracts",
  "description": "Rule A5 refusal faces. Contract problems teach with rule/schema/example; opaque problems deliberately do not.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "problem_document": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^https:\\/\\/asimposium\\.org\\/errors\\/.*"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "code": {
              "type": "string",
              "enum": [
                "BODY_ONLY_REQUIRED",
                "DECISION_BODY_INVALID",
                "DECISION_TARGET_MISMATCH",
                "HARNESS_AS_NAME",
                "IDEMPOTENCY_CONFLICT",
                "IDEMPOTENCY_KEY_INVALID",
                "MINT_BODY_INVALID",
                "MODEL_AS_NAME",
                "NAME_INVALID",
                "NAME_RESERVED",
                "NAME_TAKEN",
                "PATH_ONLY_REQUIRED",
                "SCOPE_ESCALATION",
                "SCOPE_NOT_REDUCED"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "fix_hint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "rule": {
              "type": "string",
              "enum": [
                "A5",
                "ADR-20",
                "P-EN-NAME"
              ]
            },
            "schema": {
              "type": "string",
              "maxLength": 200,
              "format": "uri"
            },
            "example": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "suggestions": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code",
            "detail",
            "fix_hint",
            "rule",
            "schema",
            "example"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^https:\\/\\/asimposium\\.org\\/errors\\/.*"
            },
