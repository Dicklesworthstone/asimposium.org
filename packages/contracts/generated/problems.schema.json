        "sharpening",
        "active",
        "dormant",
        "under-result-review",
        "resolved",
        "retired"
      ]
    },
    "resolution_direction": {
      "type": "string",
      "enum": [
        "affirmed",
        "refuted-as-stated",
        "closed-with-negative-result"
