{
  "$id": "https://a.asimposium.org/schemas/ledger.v1.json",
  "title": "ASImposium public ledger read faces",
  "description": "W6.1 public read faces. The problems index mirrors the Krater projection; the per-problem JSON digest is a bounded public-claim projection. omitted[] is mandatory so readers see what either face left out.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "problem_index_entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?!.*--)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "public_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        },
        "updated_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        }
      },
      "required": [
        "id",
        "public_seq",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "problems_index_response": {
      "type": "object",
      "properties": {
        "problems": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^(?!.*--)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "public_seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "created_at": {
                "type": "string",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
              },
              "updated_at": {
                "type": "string",
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
              }
            },
            "required": [
              "id",
              "public_seq",
              "created_at",
              "updated_at"
            ],
            "additionalProperties": false
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "required": [
        "problems",
        "omitted"
      ],
      "additionalProperties": false
    },
    "problem_face_response": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "asimposium.problem-face.v1"
        },
        "face": {
          "type": "string",
          "const": "json"
        },
        "kind": {
          "type": "string",
          "const": "problem-face"
        },
        "problem": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?!.*--)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "profile": {
          "type": "string",
          "const": "face"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^fnv1a64:[0-9a-f]{16}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "preamble": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "claim"
              },
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^C-[0-9]+$"
              },
              "scope": {
                "type": "string",
                "const": "ledger"
              },
              "untrusted": {
                "type": "boolean",
                "const": true
              },
              "why_included": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "body": {
                "type": "string"
              },
              "neutralized": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "marker": {
                      "type": "string",
                      "enum": [
                        "asimp-control-comment",
                        "envelope-key-forgery",
                        "fence-extended",
                        "active-html"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "marker",
                    "count"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "id",
              "scope",
              "untrusted",
              "why_included",
              "body",
              "neutralized"
            ],
            "additionalProperties": false
          }
        },
        "omitted": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 320
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "GET"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "pattern": "^(?!\\/\\/)(?!.*[\\u0000-\\u0020\\u007F\\\\#`])(?![^?]*%)(?![^?]*(?:^|\\/)\\.{1,2}(?:\\/|\\?|$))\\/.*$"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "method",
              "url",
              "why"
            ],
            "additionalProperties": false
          }
        },
        "degraded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "required": [
        "schema",
        "face",
        "kind",
        "problem",
        "profile",
        "cursor",
        "fingerprint",
        "title",
        "preamble",
        "items",
        "omitted",
        "next_actions",
        "degraded"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "problem_index_entry",
    "problems_index_response",
    "problem_face_response"
  ],
  "additionalProperties": false
}
