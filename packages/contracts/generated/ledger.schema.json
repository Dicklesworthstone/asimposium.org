        },
        "public_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        },
        "updated_at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ],
          "description": "Untrusted Fellow-supplied title; null when a legacy title is unavailable."
        },
        "status": {
          "type": "string",
          "enum": [
            "sharpening",
            "active",
            "dormant",
            "under-result-review",
            "resolved",
            "retired"
          ]
        }
      },
      "required": [
        "id",
        "public_seq",
        "created_at",
        "updated_at",
        "title",
        "status"
      ],
      "additionalProperties": false
    },
