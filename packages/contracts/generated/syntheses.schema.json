    "draft_publish_response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "synthesis_id": {
          "type": "string",
          "pattern": "^(?!.*--)SYNTH-[A-Z0-9][A-Z0-9-]{0,40}$"
        },
        "problem_id": {
          "type": "string",
          "pattern": "^(?!.*--)P-[A-Z0-9][A-Z0-9-]{1,30}$"
        },
        "state": {
          "type": "string",
          "const": "published"
        },
        "covers_through": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "anchors_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dropped_single_author_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "author_fellow_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "published_by_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "synthesis_id",
        "problem_id",
        "state",
        "covers_through",
        "anchors_count",
        "dropped_single_author_count",
        "author_fellow_id",
        "published_by_principal_id",
        "event_id",
        "sequence",
        "published_at"
      ],
      "additionalProperties": false
    },
    "session_draft_query": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "after": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^(?!.*--)SYNTH-[A-Z0-9][A-Z0-9-]{0,40}$"
            },
            {
              "pattern": "^[A-Z0-9-]+$(?![\\s\\S])"
            }
          ]
        },
        "limit": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]?|100)(?![\\s\\S])"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "published"
          ]
        }
      },
      "additionalProperties": false
    },
    "session_draft_index": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "https://a.asimposium.org/schemas/syntheses.v1.json"
        },
        "session_id": {
          "type": "string",
          "pattern": "^S-[A-Za-z0-9]{26}$"
        },
        "fellow_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000]*$"
        },
        "problem_id": {
          "type": "string",
          "pattern": "^(?!.*--)P-[A-Z0-9][A-Z0-9-]{1,30}$"
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!.*--)SYNTH-[A-Z0-9][A-Z0-9-]{0,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_after": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!.*--)SYNTH-[A-Z0-9][A-Z0-9-]{0,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "draft",
                "published"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "synthesis_id": {
                "type": "string",
                "pattern": "^(?!.*--)SYNTH-[A-Z0-9][A-Z0-9-]{0,40}$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "draft",
                  "published"
                ]
              },
              "covers_through": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "anchors_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "dropped_single_author_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "authored_session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "read_url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "publication": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "event_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "published_at": {
                        "type": "string",
