            },
            "author_fellow_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "author_sponsor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "declared_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "harness": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "published_by_principal_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "published_event_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "published_seq": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "published_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "created_at": {
              "type": "string"
            }
          },
          "required": [
