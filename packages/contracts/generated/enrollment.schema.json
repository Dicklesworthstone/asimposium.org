                "body_field": {
                  "type": "string",
                  "const": "flow_handle"
                },
                "value_source": {
                  "type": "string",
                  "const": "claim response body"
                },
                "pending_status": {
                  "type": "string",
                  "const": "authorization_pending"
                },
                "retry_field": {
                  "type": "string",
                  "const": "retry_after_seconds"
                }
