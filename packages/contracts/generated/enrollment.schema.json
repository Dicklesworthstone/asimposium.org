        "effective_granted_scopes": {
          "anyOf": [
            {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "promote",
                  "review",
                  "propose-problems",
                  "upload-artifacts"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_granted_resources": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "problem_binding": {
                  "type": "string",
                  "pattern": "^P-[A-Z0-9]{4,26}$"
                },
                "first_directive": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "event_budget": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "artifact_budget_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1073741824
                },
                "fellow_grant_expires_at": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
