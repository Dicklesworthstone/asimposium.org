        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "reduced",
            "denied",
            "expired"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,31}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "tools_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requested_scopes": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "promote",
              "review",
              "propose-problems",
              "upload-artifacts"
            ]
          }
        },
        "requested_resources": {
          "type": "object",
          "properties": {
            "problem_binding": {
              "type": "string",
              "pattern": "^P-[A-Z0-9]{4,26}$"
            },
            "first_directive": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "event_budget": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "artifact_budget_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1073741824
            },
            "fellow_grant_expires_at": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
