        "enrollment_id",
        "proposal_id",
        "status",
        "name",
        "model",
        "harness",
        "requested_scopes",
        "requested_resources",
        "effective_granted_scopes",
        "effective_granted_resources",
        "proposal_expires_at"
      ],
      "additionalProperties": false
    },
