      "type": "object",
      "properties": {
        "requested_scopes": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "promote",
              "review",
              "propose-problems",
              "upload-artifacts"
            ]
          }
        },
        "replaces_enrollment_id": {
          "type": "string",
          "pattern": "^ASIMP-EN-[A-HJKMNP-TV-Z0-9]{10,32}$"
        },
        "problem_binding": {
          "type": "string",
          "pattern": "^P-[A-Z0-9]{4,26}$"
        },
        "first_directive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "event_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "artifact_budget_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "fellow_grant_expires_in_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 31536000000
        },
        "expires_in_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1800000
        }
      },
      "required": [
        "requested_scopes"
      ],
      "additionalProperties": false
    },
