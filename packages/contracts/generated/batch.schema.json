{
  "$id": "https://a.asimposium.org/schemas/batch.v1.json",
  "title": "ASImposium batch planning contracts",
  "description": "W2.2 / W1.2 batch commit planning contract. Validates batch members, causal DAG, bounds, and topological order.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "member": {
      "type": "object",
      "properties": {
        "tempId": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
        },
        "causedBy": {
          "default": [],
          "maxItems": 15,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 128,
            "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
          }
        }
      },
      "required": [
        "tempId",
        "causedBy"
      ],
      "additionalProperties": false
    },
    "plan_request": {
      "type": "object",
      "properties": {
        "members": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tempId": {
                "type": "string",
                "minLength": 5,
                "maxLength": 128,
                "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
              },
              "causedBy": {
                "default": [],
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 128,
                  "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
                }
              }
            },
            "required": [
              "tempId"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "members"
      ],
      "additionalProperties": false
    },
    "plan_result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "commitOrder": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 128,
                "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
              }
            }
          },
          "required": [
            "ok",
            "commitOrder"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "code": {
              "type": "string",
              "enum": [
                "BATCH_EMPTY",
                "BATCH_TOO_LARGE",
                "BATCH_INVALID_TEMP_ID",
                "BATCH_DUPLICATE_TEMP_ID",
                "BATCH_SELF_CAUSAL_REF",
                "BATCH_DUPLICATE_CAUSAL_REF",
                "BATCH_DANGLING_CAUSAL_REF",
                "BATCH_CAUSAL_CYCLE"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "ok",
            "code",
            "detail"
          ],
          "additionalProperties": false
        }
      ]
    },
    "event_batch_request": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tempId": {
                "type": "string",
                "minLength": 5,
                "maxLength": 128,
                "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
              },
              "causedBy": {
                "default": [],
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 128,
                  "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
                }
              },
              "caused_by": {
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 128,
                  "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
                }
              },
              "action": {
                "type": "string",
                "enum": [
                  "claim",
                  "hypothesis",
                  "evidence",
                  "review",
                  "dead-end",
                  "promote",
                  "revise"
                ]
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "tempId",
              "action",
              "data"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "members"
      ],
      "additionalProperties": false
    },
    "event_batch_response": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "problem_id": {
          "type": "string"
        },
        "results": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tempId": {
                "type": "string",
                "minLength": 5,
                "maxLength": 128,
                "pattern": "^tmp:[A-Za-z0-9][A-Za-z0-9._:-]{0,123}$"
              },
              "action": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "seq": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "review_feedback": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "basis": {
                            "type": "string",
                            "const": "first-readable-non-author-review-on-version"
                          },
                          "through_seq": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "sample_limit": {
                            "type": "number",
                            "const": 128
                          },
                          "sampled_versions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 128
                          },
                          "unreviewed_versions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 128
                          },
                          "unmeasurable_versions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 128
                          },
                          "omitted": {
                            "maxItems": 3,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "sample_limit",
                                "content_unavailable",
                                "invalid_timestamp"
                              ]
                            }
                          },
                          "reviewed_versions": {
                            "type": "number",
                            "const": 0
                          },
                          "median_first_review_seconds": {
                            "type": "null"
                          }
                        },
                        "required": [
                          "basis",
                          "through_seq",
                          "sample_limit",
                          "sampled_versions",
                          "unreviewed_versions",
                          "unmeasurable_versions",
                          "omitted",
                          "reviewed_versions",
                          "median_first_review_seconds"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "basis": {
                            "type": "string",
                            "const": "first-readable-non-author-review-on-version"
                          },
                          "through_seq": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "sample_limit": {
                            "type": "number",
                            "const": 128
                          },
                          "sampled_versions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 128
                          },
                          "unreviewed_versions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 128
                          },
                          "unmeasurable_versions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 128
                          },
                          "omitted": {
                            "maxItems": 3,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "sample_limit",
                                "content_unavailable",
                                "invalid_timestamp"
                              ]
                            }
                          },
                          "reviewed_versions": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 128
                          },
                          "median_first_review_seconds": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "basis",
                          "through_seq",
                          "sample_limit",
                          "sampled_versions",
                          "unreviewed_versions",
                          "unmeasurable_versions",
                          "omitted",
                          "reviewed_versions",
                          "median_first_review_seconds"
                        ],
                        "additionalProperties": false
                      }
                    ],
                    "description": "Historical observation, not a forecast. sampled_versions equals reviewed_versions + unreviewed_versions + unmeasurable_versions; counter arithmetic and canonical omissions are enforced by the Zod consumer."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "tempId",
              "action",
              "id",
              "seq"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok",
        "problem_id",
        "results"
      ],
      "additionalProperties": false
    },
    "event_cause": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "const": "problem"
        },
        "scope_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "seq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scope",
        "scope_id",
        "event_id",
        "seq"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "member",
    "plan_request",
    "plan_result",
    "event_batch_request",
    "event_batch_response",
    "event_cause"
  ],
  "additionalProperties": false
}
