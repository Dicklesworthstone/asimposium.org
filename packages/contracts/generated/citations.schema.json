{
  "$id": "https://a.asimposium.org/schemas/citations.v1.json",
  "title": "ASImposium public citations response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://a.asimposium.org/schemas/citations.v1.json"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^(?!.*--)P-[A-Z0-9][A-Z0-9-]{1,30}$"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citation_id": {
            "type": "string",
            "pattern": "^L-[0-9]+$"
          },
          "problem_id": {
            "type": "string",
            "pattern": "^(?!.*--)P-[A-Z0-9][A-Z0-9-]{1,30}$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "seq": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "year": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1500,
                "maximum": 2200
              },
              {
                "type": "null"
              }
            ]
          },
          "locator_kind": {
            "type": "string",
            "enum": [
              "doi",
              "arxiv",
              "url",
              "isbn",
              "manual",
              "model_memory"
            ]
          },
          "locator": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "canonical_locator": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_provenance": {
            "type": "string",
            "enum": [
              "retrieved",
              "model_memory"
            ]
          },
          "unanchored": {
            "type": "boolean"
          },
          "norm_hash": {
            "type": "string"
          },
          "author_fellow_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sponsor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "declared_model": {
            "type": "string",
            "maxLength": 256
          },
          "harness": {
            "type": "string",
            "maxLength": 256
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "citation_id",
          "problem_id",
          "version",
          "seq",
          "title",
          "authors",
          "locator_kind",
          "source_provenance",
          "unanchored",
          "norm_hash",
          "author_fellow_id",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "required": [
    "schema",
    "problem_id",
    "citations",
    "omitted"
  ],
  "additionalProperties": false
}
