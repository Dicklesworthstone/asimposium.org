{
  "name": "@asimposium/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Diptych renderers: one projection -> md / json / html-fragment, with one sanitization path.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "exports": {
    ".": "./src/index.ts",
    "./math": "./src/math.ts",
    "./math.css": "./styles/math.css",
    "./scientific-markdown": "./src/scientific-markdown.ts",
    "./formal-records": "./src/formal-records.ts",
    "./hypothesis-evidence-index": "./src/hypothesis-evidence-index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts package.json tsconfig.json",
    "test": "bun test /dev/null --timeout=120000 test",
    "test:unit": "bun test /dev/null --timeout=120000 test/unit",
    "test:contract": "bun test /dev/null --timeout=120000 test/contract",
    "test:integration": "bun test /dev/null --timeout=120000 test/integration",
    "test:security": "bun test /dev/null --timeout=120000 test/security",
    "report": "bun run scripts/suite-report.ts",
    "golden:print": "bun scripts/golden-print.ts",
    "spike:s5": "bun scripts/s5-spike.ts"
  },
  "dependencies": {
    "@asimposium/contracts": "workspace:*",
    "katex": "0.19.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@asimposium/contracts": "workspace:*",
    "@types/bun": "1.3.8",
    "@types/mdast": "4.0.4",
    "typescript": "5.9.3"
  }
}
