{
  "name": "@asimposium/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Diptych renderers: one projection -> md / json / html-fragment, with one sanitization path.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts package.json tsconfig.json",
    "test": "bun test --config /dev/null --timeout=120000",
    "test:unit": "bun test --config /dev/null --timeout=120000 test/unit",
    "test:contract": "bun test --config /dev/null --timeout=120000 test/contract",
    "test:integration": "bun test --config /dev/null --timeout=120000 test/integration",
    "test:security": "bun test --config /dev/null --timeout=120000 test/security",
    "report": "bun run scripts/suite-report.ts",
    "golden:print": "bun scripts/golden-print.ts",
    "spike:s5": "bun scripts/s5-spike.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "typescript": "5.9.3"
  }
}
